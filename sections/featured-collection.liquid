{% assign collection = collections['new-arrivals'] %}
{% if collection != blank and collection.products.size > 0 %}
<style>
  .featured-new-arrivals-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  @media (min-width: 750px) {
    .featured-new-arrivals-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .featured-new-arrivals-card {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .featured-new-arrivals-card__image-wrapper {
    position: relative;
  }
  .featured-new-arrivals-card__image {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
  }
  .featured-new-arrivals-card__cta {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .featured-new-arrivals-card:hover .featured-new-arrivals-card__cta {
    opacity: 1;
  }
  .featured-new-arrivals-card__title {
    margin-top: 8px;
  }
  .featured-new-arrivals-card__price {
    margin-top: 4px;
  }
</style>

<div class="page-width">
  <ul class="featured-new-arrivals-grid" role="list">
    {% for product in collection.products %}
      <li>
        <a href="{{ product.url }}" class="featured-new-arrivals-card">
          <div class="featured-new-arrivals-card__image-wrapper">
            {% assign image = product.featured_image %}
            <img
              src="{{ image | image_url: width: 640 }}"
              srcset="{{ image | image_url: width: 320 }} 320w, {{ image | image_url: width: 640 }} 640w, {{ image | image_url: width: 960 }} 960w"
              sizes="(min-width: 750px) 25vw, 50vw"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              class="featured-new-arrivals-card__image"
            >
            <span class="featured-new-arrivals-card__cta">View details</span>
          </div>
          <h3 class="featured-new-arrivals-card__title">{{ product.title }}</h3>
          <div class="featured-new-arrivals-card__price">{{ product.price | money }}</div>
        </a>
      </li>
    {% endfor %}
  </ul>
</div>
{% endif %}

{% schema %}
{
  "name": "Featured collection",
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
